---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, SITE_LOCALE, GOOGLE_SITE_VERIFICATION, NAVER_SITE_VERIFICATION } from '../site.config.mjs';
import { CATEGORIES } from '../data/categories.mjs';

interface Props {
  title: string;            // 페이지 고유 제목
  description: string;      // 페이지 고유 설명
  type?: 'website' | 'article';
  jsonLd?: object[];        // JSON-LD 객체 배열
  current?: string;         // 현재 카테고리 key (네비 강조)
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}
const { title, description, type = 'website', jsonLd = [], current, publishedTime, modifiedTime, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL('/og-default.png', Astro.site).href;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <!-- ===== 검색엔진 소유확인 메타태그 (src/site.config.mjs 에서 값 입력) ===== -->
  <!-- Google Search Console: GOOGLE_SITE_VERIFICATION -->
  {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
  <!-- Naver Search Advisor: NAVER_SITE_VERIFICATION -->
  {NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
  <!-- ===== /검색엔진 소유확인 ===== -->

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={SITE_LOCALE} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#2f7d6d" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap.xml" />
  {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#content">본문 바로가기</a>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">육아템 <span>노트</span></a>
      <span class="meta">{SITE_TAGLINE}</span>
    </div>
    <nav class="cats" aria-label="월령별 카테고리">
      <div class="wrap">
        {CATEGORIES.map((c) => (
          <a href={`/category/${c.key}/`} aria-current={current === c.key ? 'page' : undefined}>{c.name}{c.key !== 'guide' && ` (${c.range})`}</a>
        ))}
      </div>
    </nav>
  </header>
  <main id="content">
    <div class="wrap"><slot /></div>
  </main>
  <footer class="site">
    <div class="wrap">
      <p><a href="/">홈</a> · {CATEGORIES.map((c, i) => <><a href={`/category/${c.key}/`}>{c.name}</a>{i < CATEGORIES.length - 1 && ' · '}</>)} · <a href="/about/">사이트 소개·광고 고지</a></p>
      <p>이 사이트의 일부 링크는 쿠팡 파트너스 제휴 링크이며, 이를 통해 구매가 이루어지면 운영자가 일정액의 수수료를 받을 수 있습니다. 구매자가 추가로 부담하는 비용은 없습니다.</p>
      <p>건강·의료 관련 내용은 일반 정보이며 진료를 대신하지 않습니다. 아이의 상태가 걱정되면 소아청소년과 전문의와 상담하세요.</p>
      <p>© {new Date().getFullYear()} {SITE_NAME}</p>
    </div>
  </footer>
</body>
</html>
